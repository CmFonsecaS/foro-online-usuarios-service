# Copiar a .env y completar. El .env y el wallet estan en .gitignore.
# <servicio> es el alias que aparece en tnsnames.ora del wallet (por ejemplo midb_medium).

# Ejecutando con Docker (el wallet se monta en /app/wallet):
DB_URL=jdbc:oracle:thin:@<servicio>?TNS_ADMIN=/app/wallet
# Ejecutando local con mvnw usa la ruta real del wallet:
# DB_URL=jdbc:oracle:thin:@<servicio>?TNS_ADMIN=C:/ruta/oracle-wallet

DB_USERNAME=FORO_APP
DB_PASSWORD=<contrasena>

# Clave Base64 de al menos 32 bytes, igual en todos los microservicios
JWT_SECRET=<clave-base64>

CORS_ORIGINS=http://localhost:4200
